@model KsiazkaKucharska.Models.Przepisy

@{
    ViewData["Title"] = "Edytuj przepis";
}

<h1>Edytuj przepis</h1>

<form asp-action="Edytuj">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Skladnik" class="control-label"></label>
        <textarea asp-for="Skladnik" class="form-control"></textarea>
        <span asp-validation-for="Skladnik" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Instrukcja" class="control-label"></label>
        <textarea asp-for="Instrukcja" class="form-control"></textarea>
        <span asp-validation-for="Instrukcja" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <input type="submit" value="Zapisz zmiany" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}